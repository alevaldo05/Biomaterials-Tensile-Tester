{
  "name": "biomaterials-tensile-tester",
  "private": true,
  "description": "Workspace for the tester app, its shared packages, and the back end. The website at the repository root needs none of this to run.",
  "workspaces": [
    "packages/*",
    "apps/tester",
    "apps/api"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "reference:update": "node packages/core/reference/update-fixtures.mjs",
    "check:site": "node scripts/check-site.js",
    "app": "npm run dev -w @tensile/tester",
    "app:build": "npm run build -w @tensile/tester"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
