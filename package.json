{
  "name": "biomaterials-tensile-tester",
  "private": true,
  "description": "Workspace for the tester app, its shared packages, and the back end. The website at the repository root needs none of this to run.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "reference:update": "node packages/core/reference/update-fixtures.mjs",
    "check:site": "node scripts/check-site.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
