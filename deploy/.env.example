# Copy to .env (in this folder) and fill in. .env is not committed.
# A long random password for the database (only the API uses it).
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Where the system is reachable. 127.0.0.1 = this computer only (recommended; Web Serial needs localhost or HTTPS).
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Leave false while it is reached over plain http://localhost. Set true once HTTPS is in front of it.
COOKIE_SECURE=false
SESSION_HOURS=12

# Versions of each part. Change one and run: docker compose up -d --no-deps <service>
IMAGE_PREFIX=tensile
GATEWAY_VERSION=local
WEB_VERSION=local
APP_VERSION=local
API_VERSION=local
POSTGRES_VERSION=16-alpine


# HTTPS: published on this port when deploy/certs/cert.pem and key.pem exist (see make-cert.sh). Set COOKIE_SECURE=true above when everyone uses HTTPS.
HTTPS_PORT=8443

# Scheduled backups into deploy/backups: one every this many hours (whole number), keeping the newest BACKUP_KEEP files.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# Seconds after start before the first backup (300 = 5 minutes, so the database is up). CI sets a few seconds.
BACKUP_FIRST_DELAY_SECONDS=300
