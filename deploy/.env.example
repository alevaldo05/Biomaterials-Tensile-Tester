# Copy to .env (in this folder) and fill in. .env is not committed.
# A long random password for the database (only the API uses it).
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Where the system is reachable. 127.0.0.1 = this computer only (recommended; Web Serial needs localhost or HTTPS).
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Leave false while it is reached over plain http://localhost. Set true once HTTPS is in front of it.
COOKIE_SECURE=false
SESSION_HOURS=12

# Versions of each part. Change one and run: docker compose up -d --no-deps <service>
IMAGE_PREFIX=tensile
GATEWAY_VERSION=local
WEB_VERSION=local
APP_VERSION=local
API_VERSION=local
POSTGRES_VERSION=16-alpine

