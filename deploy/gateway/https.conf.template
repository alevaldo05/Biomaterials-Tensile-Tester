# Added to the gateway only when deploy/certs/cert.pem and key.pem exist (see 40-https.sh). Same routes as the HTTP server.
# HSTS is deliberately not sent: with a self-signed certificate it could lock people out of the site.
server {
  listen 443 ssl;
  http2 on;
  server_tokens off;
  ssl_certificate     /etc/nginx/certs/cert.pem;
  ssl_certificate_key /etc/nginx/certs/key.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:5m;
  ssl_session_timeout 1h;
  ssl_session_tickets off;
  include /etc/nginx/gateway-routes.conf;
}
